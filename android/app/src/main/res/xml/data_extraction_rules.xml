<?xml version="1.0" encoding="utf-8"?>
<!-- Auth token lives in EncryptedSharedPreferences; excluded from backup/
     transfer so a device restore never carries a live session to a new
     device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
