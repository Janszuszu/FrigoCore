# ============================================
# FrigoCore - Root Environment Variables
# Consumed by docker-compose.yml.
#
# Copy to .env and fill in real values before running `docker compose up -d`.
# .env is gitignored — never commit real secrets here.
#
# Generate strong random values with, e.g.:
#   openssl rand -hex 32
# ============================================

# Backend CORS
# Comma-separated list of browser origins allowed to call the API.
# Leave empty in production: the SPA is served from the same origin as the
# API through Caddy, so no cross-origin request happens at all.
# NEVER set this to "*" — credentials are allowed on CORS responses, and a
# wildcard would let any website read authenticated API responses.
CORS_ORIGINS=

# PostgreSQL
POSTGRES_PASSWORD=

# Redis
REDIS_PASSWORD=

# EMQX
EMQX_NODE_COOKIE=
EMQX_DASHBOARD_PASSWORD=

# Firebase Cloud Messaging — absolute path on the HOST to the service-account
# JSON key file. Bind-mounted read-only into the backend container at
# /opt/FrigoCore/secrets/firebase-service-account.json. Leave empty to run
# without FCM (dispatch pushes will fail clearly rather than silently).
# NEVER commit the key file itself — see backend/.gitignore.
FIREBASE_CREDENTIALS_HOST_PATH=

# MQTT broker credentials
# frigocore-backend uses MQTT_BACKEND_PASSWORD to subscribe to frigo/#
# frigocore-esp uses MQTT_ESP_PASSWORD to publish to frigo/#
# frigocore-dr154-01 (USR-DR154-E gateway) publishes only to frigo/dr154-01/data
# frigocore-esp-test (ESP32 test device) publishes only to frigo/test/komora
MQTT_BACKEND_PASSWORD=
MQTT_ESP_PASSWORD=
MQTT_DR154_01_PASSWORD=
MQTT_ESP_TEST_PASSWORD=
# frigocore-opi-kotlety-01 (Orange Pi Zero 3 gateway) publishes to frigo/kotlety-biskupiec/#
MQTT_OPI_KOTLETY_01_PASSWORD=
