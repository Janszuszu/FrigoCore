# ============================================
# FrigoCore - Root Environment Variables
# Consumed by docker-compose.yml.
#
# Copy to .env and fill in real values before running `docker compose up -d`.
# .env is gitignored — never commit real secrets here.
#
# Generate strong random values with, e.g.:
#   openssl rand -hex 32
# ============================================

# PostgreSQL
POSTGRES_PASSWORD=

# Redis
REDIS_PASSWORD=

# EMQX
EMQX_NODE_COOKIE=
EMQX_DASHBOARD_PASSWORD=

# Firebase Cloud Messaging — absolute path on the HOST to the service-account
# JSON key file. Bind-mounted read-only into the backend container at
# /opt/FrigoCore/secrets/firebase-service-account.json. Leave empty to run
# without FCM (dispatch pushes will fail clearly rather than silently).
# NEVER commit the key file itself — see backend/.gitignore.
FIREBASE_CREDENTIALS_HOST_PATH=

# MQTT broker credentials
# frigocore-backend uses MQTT_BACKEND_PASSWORD to subscribe to frigo/#
# frigocore-esp / firmware share MQTT_ESP_PASSWORD to publish to frigo/#
MQTT_BACKEND_PASSWORD=
MQTT_ESP_PASSWORD=
