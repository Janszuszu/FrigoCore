# ============================================
# FrigoCore - Root Environment Variables
# Consumed by docker-compose.yml.
#
# Copy to .env and fill in real values before running `docker compose up -d`.
# .env is gitignored — never commit real secrets here.
#
# Generate strong random values with, e.g.:
#   openssl rand -hex 32
# ============================================

# PostgreSQL
POSTGRES_PASSWORD=

# Redis
REDIS_PASSWORD=

# EMQX
EMQX_NODE_COOKIE=
EMQX_DASHBOARD_PASSWORD=

# MQTT broker credentials
# frigocore-backend uses MQTT_BACKEND_PASSWORD to subscribe to frigo/#
# frigocore-esp / firmware share MQTT_ESP_PASSWORD to publish to frigo/#
MQTT_BACKEND_PASSWORD=
MQTT_ESP_PASSWORD=
