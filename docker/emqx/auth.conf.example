# Reference only — NOT used at runtime.
#
# The real docker/emqx/auth.conf no longer exists in the repo or in git
# history going forward. It is generated at container startup by the
# emqx-config-init service (docker/emqx/render-auth-conf.sh) from the
# MQTT_BACKEND_PASSWORD / MQTT_ESP_PASSWORD values in your .env file.
#
# Format (username:password, one per line):
frigocore-backend:<MQTT_BACKEND_PASSWORD>
frigocore-esp:<MQTT_ESP_PASSWORD>
firmware:<MQTT_ESP_PASSWORD>
