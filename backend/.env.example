# ============================================
# FrigoCore - Backend Environment Variables
# Copy to .env and update values
# ============================================

# Application
APP_NAME=FrigoCore
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://frigocore:frigocore_dev@localhost:5432/frigocore

# Redis
REDIS_URL=redis://:frigocore_redis_dev@localhost:6379/0

# EMQX / MQTT
EMQX_HOST=localhost
EMQX_PORT=1883
MQTT_WS_URL=ws://localhost:8083

# Security
SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Firebase Cloud Messaging — path to a service-account JSON key file.
# Required for SERVICE_ALARM push dispatch. Never commit the key file itself.
FIREBASE_CREDENTIALS_PATH=
